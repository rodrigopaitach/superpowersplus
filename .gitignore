.worktrees/
.private-journal/
.claude/
.superpowers/
.DS_Store
node_modules/
inspo
triage/

# Eval harness lives in its own repository, cloned into evals/ for local
# development (see CLAUDE.md / README.md). It is not part of the published
# plugin, so the whole directory is ignored here.
evals/

# Scratch directories for adversarial skill-behavior runs (tests/skill-behavior/).
# A glob, not an enumeration: the list was written as .skillrun/, .skillrun2/,
# .skillrun3/ and the third measurement used .skillrun4/, which no line covered.
# A pattern that has to be extended by hand at every run is a pattern that is
# stale at every run.
.skillrun*/

# Reading material kept beside the work — articles, transcripts, diagrams read
# while deciding something here. Local to whoever is reading it, not part of
# the published plugin, and heavy: the first one to land was 6.8 MB of PDF.
research/

# Python bytecode. `skills/writing-plans/scripts/mdfence.py` is imported by
# gates that run from a pre-commit hook and from inside an installed plugin
# directory; without this, any invocation without `-B` drops a committable
# .pyc into a `skills/` tree that ships to Codex wholesale. The two carriers
# also set sys.dont_write_bytecode — this rule is the one that covers callers
# nobody has written yet.
__pycache__/
*.pyc
