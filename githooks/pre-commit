#!/usr/bin/env bash
#
# pre-commit — versioned repository hooks.
#
# Activate once per clone (.git/ is not versionable, so this cannot be
# automatic):
#   git config core.hooksPath githooks
#
# Add further checks below; this file is the single entry point.
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

"$repo_root/scripts/check-docs-sync.sh"
"$repo_root/scripts/check-frozen-history.sh"
"$repo_root/scripts/check-changelog.sh"

# Unlike the three above, this one does not read the index: it scans the whole
# tree, because a link breaks when its DESTINATION disappears, not only when
# the markdown holding it changes. README.md cites
# tests/skill-behavior/RESULT-escalation-format-in-chat-v3.md, which is not one
# of the scanned files — gating on "a scanned file is staged" would miss a
# commit that renames it. Measured at 30ms for the whole repository, which is
# cheaper than the bookkeeping that ignoring it would need.
"$repo_root/scripts/check-links.sh" >/dev/null

# Whole-tree for the same reason, and cheap for a different one: no
# interpreter starts, just wc over fifteen files.
"$repo_root/scripts/check-skill-size.sh"

# Whole-tree too, and for a reason peculiar to it: the five carriers of the
# evidence line are edited one at a time, so a range-scoped check would read
# the one being changed and never the four it must match.
"$repo_root/scripts/check-evidence-line.sh"

# The same reason again, for the second form this project copies on purpose.
# Six carriers across five skills — subagent-driven-development holds it twice.
"$repo_root/scripts/check-escalation-shape.sh"
