#!/usr/bin/env bash
#
# check-cross-references — the ids, tests and citations a document names all resolve.
#
# Run this between fixing a reviewer's blocking issues and re-dispatching the
# reviewer. It is the mechanical half of that step: set extraction and set
# comparison over one spec or plan, the same pass a plan reviewer once ran by
# hand and reported as "40/40, by extracting and comparing sets, not by reading".
#
# It exists because the fix pass is where these break. A document dense in ids
# is edited in pieces by the same author who wrote it: renumbering AC1-AC7
# leaves a pointer at the old AC2, renaming a test leaves the criterion naming
# the old one, adding a task leaves "PASS on the six". None of that is
# judgement — it is a set difference, and paying a reviewer subagent to find it
# costs a whole round.
#
# WHAT IT DOES NOT COVER — read this before trusting a pass:
#   * Whether a cited line SAYS what the citation claims. It checks that the
#     file opens and is long enough, never the content. `verify.ts:88` pointing
#     at a blank line passes here. That half is judgement and stays in the
#     skill's prose step.
#   * Whether an id that resolves is the RIGHT id. `F4` naming a real AC that
#     means something else reads as clean.
#   * Whether a test named in the matrix asserts anything. Existence only.
#   * Counts stated in prose ("PASS on the six"). It compares structure it can
#     extract — matrix labels against matrix rows, tasks announced against
#     tasks present — not arbitrary sentences.
#   * A citation whose path is deliberately unresolvable — a placeholder, or a
#     path inside a third-party package. Those are reported; judge them.
#
# Usage:
#   check-cross-references DOCUMENT [REPO_ROOT]
#
#   DOCUMENT    the spec or plan to check
#   REPO_ROOT   root the file:line citations resolve against (default: cwd)
#
# Exit 1 when anything does not resolve.
#
set -euo pipefail

usage() {
  sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'
}

if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 1
fi

doc="$1"
root="${2:-$PWD}"

[[ -f "$doc" ]] || {
  echo "check-cross-references: no such document: $doc" >&2
  exit 1
}

script_dir="$(cd "$(dirname "$0")" && pwd)"
python3 - "$doc" "$root" "$script_dir" <<'PY'
import re
import sys
from pathlib import Path

doc = Path(sys.argv[1])
root = Path(sys.argv[2])
text = doc.read_text(encoding="utf-8")
lines = text.splitlines()

# The module is a sibling of this script. Resolve it from the script's own
# path, never the working directory: this gate runs from a pre-commit hook and
# against documents in other repositories. `dont_write_bytecode` keeps the
# import from leaving a __pycache__ inside an installed plugin.
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[3])
from mdfence import fence_mask, prose

# Structural extractors read `prose_lines`/`prose_text`; content extractors
# (the test finder, the citation pass, the id-citation pass) keep reading the
# raw text, each for a measured reason recorded in the design.
fenced, unclosed_at = fence_mask(lines)
prose_lines = prose(lines)
prose_text = "\n".join(prose_lines)

failures = []
counts = {}

if unclosed_at is not None:
    failures.append(
        f"a fenced block opens at line {unclosed_at} and never closes — "
        "every heading after it reads as fenced, which turns the checks off "
        "rather than failing them"
    )


HEADING = re.compile(r"^(#{1,6})\s")


def section(title_re):
    """Body of the first `## <title>` section, to the next same-or-shallower heading."""
    start = None
    level = None
    for i, line in enumerate(prose_lines):
        match = HEADING.match(line)
        if not match:
            continue
        if start is not None:
            if len(match.group(1)) <= level:
                return "\n".join(lines[start:i])
            continue
        if re.match(rf"^#{{2,3}}\s+{title_re}\s*$", line, re.I):
            start = i + 1
            level = len(match.group(1))
    return "\n".join(lines[start:]) if start is not None else None


# ---------------------------------------------------------------- ids
# Defined where the list that owns them lives; cited anywhere else.
AC_IR = re.compile(r"\b((?:AC|IR)\d+[a-z]?)\b")
TASK_CRIT = re.compile(r"\b(T\d+\.\d+[a-z]?)\b")

defining = []
for title in (r"Acceptance Criteria", r"Implicit Requirements"):
    body = section(title)
    if body:
        defining.append(body)

defined_ac = set()
for body in defining:
    defined_ac |= set(AC_IR.findall(body))

cited_ac = set(AC_IR.findall(text))
counts["AC/IR defined"] = len(defined_ac)
counts["AC/IR cited"] = len(cited_ac)

# Only charge dangling ids when the document actually carries the defining
# lists. A plan cites its spec's ids without defining them; that is correct.
if defined_ac:
    dangling = sorted(cited_ac - defined_ac, key=lambda s: (len(s), s))
    if dangling:
        failures.append(
            "ids cited but not defined in `## Acceptance Criteria` / "
            "`## Implicit Requirements`: " + ", ".join(dangling)
        )

# Task criteria: defined by the task bodies, cited by the matrix.
all_task_crit = set(TASK_CRIT.findall(prose_text))
counts["task criteria"] = len(all_task_crit)

matrix_rows = [
    ln for ln in prose_lines
    if ln.lstrip().startswith("|") and TASK_CRIT.search(ln)
]
matrix_labels = set()
for ln in matrix_rows:
    matrix_labels |= set(TASK_CRIT.findall(ln))

# A label that appears ONLY inside matrix rows is defined nowhere else.
outside_matrix = set()
for ln in prose_lines:
    if ln.lstrip().startswith("|"):
        continue
    outside_matrix |= set(TASK_CRIT.findall(ln))

if matrix_labels:
    counts["matrix rows"] = len(matrix_rows)
    counts["matrix labels"] = len(matrix_labels)
    orphan_in_matrix = sorted(matrix_labels - outside_matrix)
    if orphan_in_matrix:
        failures.append(
            "criteria in the coverage matrix with no matching criterion in a "
            "task body: " + ", ".join(orphan_in_matrix)
        )
    orphan_in_body = sorted(outside_matrix - matrix_labels)
    if orphan_in_body:
        failures.append(
            "criteria in a task body with no row in the coverage matrix: "
            + ", ".join(orphan_in_body)
        )
    dupes = sorted(lbl for lbl in matrix_labels
                   if sum(1 for ln in matrix_rows
                          if lbl in TASK_CRIT.findall(ln)) > 1)
    if dupes:
        failures.append(
            "criteria carrying more than one matrix row: " + ", ".join(dupes)
        )

# ------------------------------------------------------------- tasks
task_headings = [ln for ln in prose_lines if re.match(r"^#{2,3}\s+Task\s+\d+\b", ln)]
if task_headings:
    counts["tasks present"] = len(task_headings)
    for m in re.finditer(r"\b(?:has|with)\s+(\d+)\s+tasks?\b", prose_text, re.I):
        announced = int(m.group(1))
        if announced != len(task_headings):
            failures.append(
                f"the document announces {announced} tasks and carries "
                f"{len(task_headings)}"
            )
            break

# ------------------------------------------------------------- tests
# Every test named in the matrix is created by some step of some task.
#
# "Created" is deliberately language-blind: the name appears inside one of the
# document's fenced code blocks, which is where a step writes a test. Parsing
# test-definition syntax meant carrying a pattern per language, and it did not
# carry this repository's own — bash suites name their cases with shell
# function calls, and 26 real tests read as absent on the plan for this branch.
#
# Searching the whole document instead of the code blocks does NOT work:
# writing-plans requires every task criterion to name its covering test, so the
# criterion line carries the name even when a step renamed the test, and the
# check passes on the one defect it exists for.
in_code = "\n".join(ln for i, ln in enumerate(lines) if fenced[i])

# Matrix cells name a test as `> name`, `file.py::name`, or `file:line > name`.
named_in_matrix = set()
for ln in matrix_rows:
    for cell in ln.split("|"):
        cell = cell.strip().strip("`")
        m = re.search(r">\s*(.+?)\s*$", cell)
        if m:
            named_in_matrix.add(m.group(1).strip().strip("`"))
        m = re.search(r"::(\w+)\s*$", cell)
        if m:
            named_in_matrix.add(m.group(1))

if named_in_matrix:
    counts["tests named in matrix"] = len(named_in_matrix)
    missing = sorted(n for n in named_in_matrix if n not in in_code)
    if missing:
        failures.append(
            "tests named in the coverage matrix that no step creates: "
            + "; ".join(f"`{n}`" for n in missing)
        )

# --------------------------------------------------------- citations
# `path/file.ext:NN` — the path opens and is long enough. Content is judgement.
#
# A citation is routinely written short (`page.tsx:7` for a file nested deep),
# which is a real convention and not a defect. So a path that does not resolve
# from the root is resolved by SUFFIX against the tracked files. Exactly one
# match resolves it; none is a dead citation; several is ambiguous, which is
# its own defect — the reader cannot tell which file was meant either.
tracked = []
try:
    import subprocess
    out = subprocess.run(
        ["git", "-C", str(root), "ls-files"],
        capture_output=True, text=True, check=False,
    )
    if out.returncode == 0:
        tracked = out.stdout.splitlines()
except OSError:
    pass


def resolve(rel):
    """(path, note) — note is non-empty when the citation was not literal."""
    direct = root / rel
    if direct.is_file():
        return direct, ""
    if not tracked:
        return None, "no such file, and the tracked-file list is unavailable"
    hits = [t for t in tracked if t == rel or t.endswith("/" + rel)]
    if len(hits) == 1:
        return root / hits[0], f"short form, resolved to {hits[0]}"
    if not hits:
        return None, f"no tracked file matches under {root}"
    return None, "ambiguous short form — " + ", ".join(sorted(hits)[:4])


CITATION = re.compile(r"`([^`\s]+\.[A-Za-z0-9_]+):(\d+)(?:-(\d+))?`")
seen_citations = set()
unresolved = []
shortened = 0
for m in CITATION.finditer(text):
    rel, first, last = m.group(1), int(m.group(2)), m.group(3)
    key = (rel, first, last)
    if key in seen_citations:
        continue
    seen_citations.add(key)
    if "<" in rel:
        continue  # placeholder, unresolvable on purpose
    path, note = resolve(rel)
    if path is None:
        unresolved.append(f"`{rel}:{first}` — {note}")
        continue
    if note:
        shortened += 1
    try:
        n = sum(1 for _ in path.open(encoding="utf-8", errors="replace"))
    except OSError as exc:
        unresolved.append(f"`{rel}:{first}` — cannot read: {exc}")
        continue
    end = int(last) if last else first
    if end > n:
        unresolved.append(
            f"`{rel}:{first}` — {path.name} has {n} line(s)"
            + (f" ({note})" if note else "")
        )

counts["file:line citations"] = len(seen_citations)
if shortened:
    counts["resolved by suffix"] = shortened
if unresolved:
    failures.append(
        "citations that do not open:\n    " + "\n    ".join(unresolved)
    )

# ----------------------------------------------------------- verdict
summary = ", ".join(f"{k} {v}" for k, v in counts.items())
if failures:
    print(f"check-cross-references: {doc}", file=sys.stderr)
    for f in failures:
        print(f"  - {f}", file=sys.stderr)
    print(
        f"\ncounts: {summary}\n"
        "\nThese are the breaks a fix pass leaves behind. Repair them before "
        "re-dispatching the reviewer — a round spent reporting a dangling id "
        "is a round not spent on the document.",
        file=sys.stderr,
    )
    sys.exit(1)

print(f"check-cross-references: {doc} — every reference resolves ({summary})")
PY
